        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^13.5.0",
        "axios": "^1.16.1",
        "gh-pages": "^6.3.0",
        "i18next": "^26.2.0",
        "i18next-browser-languagedetector": "^8.2.1",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-hook-form": "^7.76.0",
        "react-i18next": "^17.0.8",
        "react-redux": "^9.3.0",
        "react-router-dom": "^7.14.2",
